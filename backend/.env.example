# API Configuration
API_ENV=development
API_KEY=your-secret-key-here
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://0.0.0.0:3000

# Database
DATABASE_URL=sqlite:///./industrial_troubleshooting.db
# Or for PostgreSQL: postgresql://user:password@localhost/industrial_ai

# Vector Store
VECTOR_DB_TYPE=faiss
VECTOR_DB_PATH=./data/vector_store
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# LLM Configuration - Using Groq API
LLM_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama3-70b-8192

# Alternative LLM providers (optional)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# File Upload
UPLOAD_DIRECTORY=./uploads
MAX_FILE_SIZE_MB=100

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# Neo4j Knowledge Graph (optional)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
USE_NEO4J=false

# Search Configuration
MIN_CONFIDENCE_SCORE=0.3
MAX_SEARCH_RESULTS=10
HYBRID_SEARCH_SEMANTIC_WEIGHT=0.7
HYBRID_SEARCH_KEYWORD_WEIGHT=0.3

# Chunking Configuration
CHUNK_SIZE=1024
CHUNK_OVERLAP=256
MIN_CHUNK_SIZE=256
